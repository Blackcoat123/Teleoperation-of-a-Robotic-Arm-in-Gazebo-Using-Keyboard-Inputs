<?xml version="1.0"?>
<robot name="simple_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- Define colors -->
<material name="silver">
    <color rgba="0.9 0.9 0.98 1.0"/>
</material>

<material name="gray">
    <color rgba="0.75 0.75 0.75 1.0"/>
</material>

<material name="red">
    <color rgba="0.8 0.2 0.2 1.0"/>
</material>

<!-- Base Link -->
<link name="base_link">
    <inertial>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <mass value="2.0"/>
        <inertia ixx="0.01" ixy="0.0" ixz="0.0"
                 iyy="0.01" iyz="0.0" izz="0.02"/>
    </inertial>
    <visual>
        <geometry>
            <cylinder radius="0.1" length="0.05"/>
        </geometry>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <material name="gray"/>
    </visual>
    <collision>
        <geometry>
            <cylinder radius="0.1" length="0.05"/>
        </geometry>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
    </collision>
</link>

<!-- Joint 1: Base rotation -->
<joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="150.0" velocity="2.0"/>
</joint>

<link name="link_1">
    <inertial>
        <origin xyz="0 0 0.1" rpy="0 0 0"/>
        <mass value="1.0"/>
        <inertia ixx="0.02" ixy="0.0" ixz="0.0"
                 iyy="0.02" iyz="0.0" izz="0.005"/>
    </inertial>
    <visual>
        <geometry>
            <cylinder radius="0.04" length="0.2"/>
        </geometry>
        <origin xyz="0 0 0.1" rpy="0 0 0"/>
        <material name="silver"/>
    </visual>
    <collision>
        <geometry>
            <cylinder radius="0.04" length="0.2"/>
        </geometry>
        <origin xyz="0 0 0.1" rpy="0 0 0"/>
    </collision>
</link>

<!-- Joint 2: Shoulder -->
<joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57079" upper="1.57079" effort="150.0" velocity="2.0"/>
</joint>

<link name="link_2">
    <inertial>
        <origin xyz="0.15 0 0" rpy="0 0 0"/>
        <mass value="1.5"/>
        <inertia ixx="0.02" ixy="0.0" ixz="0.0"
                 iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
    <visual>
        <geometry>
            <cylinder radius="0.03" length="0.3"/>
        </geometry>
        <origin xyz="0.15 0 0" rpy="0 1.5708 0"/>
        <material name="silver"/>
    </visual>
    <collision>
        <geometry>
            <cylinder radius="0.04" length="0.3"/>
        </geometry>
        <origin xyz="0.15 0 0" rpy="0 1.5708 0"/>
    </collision>
</link>

<!-- Joint 3: Elbow -->
<joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0.3 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57079" upper="1.57079" effort="100.0" velocity="2.0"/>
</joint>

<link name="link_3">
    <inertial>
        <origin xyz="0.1 0 0" rpy="0 0 0"/>
        <mass value="1.0"/>
        <inertia ixx="0.015" ixy="0.0" ixz="0.0"
                 iyy="0.05" iyz="0.0" izz="0.05"/>
    </inertial>
    <visual>
        <geometry>
            <cylinder radius="0.025" length="0.2"/>
        </geometry>
        <origin xyz="0.1 0 0" rpy="0 1.5708 0"/>
        <material name="silver"/>
    </visual>
    <collision>
        <geometry>
            <cylinder radius="0.03" length="0.2"/>
        </geometry>
        <origin xyz="0.1 0 0" rpy="0 1.5708 0"/>
    </collision>
</link>

<!-- Joint 4: Wrist roll -->
<joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0.2 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="50.0" velocity="3.0"/>
</joint>

<link name="link_4">
    <inertial>
        <origin xyz="0.05 0 0" rpy="0 0 0"/>
        <mass value="0.5"/>
        <inertia ixx="0.01" ixy="0.0" ixz="0.0"
                 iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
    <visual>
        <geometry>
            <cylinder radius="0.02" length="0.1"/>
        </geometry>
        <origin xyz="0.05 0 0" rpy="0 1.5708 0"/>
        <material name="silver"/>
    </visual>
    <collision>
        <geometry>
            <cylinder radius="0.025" length="0.1"/>
        </geometry>
        <origin xyz="0.05 0 0" rpy="0 1.5708 0"/>
    </collision>
</link>

<!-- Joint 5: Wrist pitch -->
<joint name="joint_5" type="revolute">
    <parent link="link_4"/>
    <child link="link_5"/>
    <origin xyz="0.1 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57079" upper="1.57079" effort="50.0" velocity="3.0"/>
</joint>

<link name="link_5">
    <inertial>
        <origin xyz="0.04 0 0" rpy="0 0 0"/>
        <mass value="0.3"/>
        <inertia ixx="0.005" ixy="0.0" ixz="0.0"
                 iyy="0.005" iyz="0.0" izz="0.005"/>
    </inertial>
    <visual>
        <geometry>
            <cylinder radius="0.015" length="0.08"/>
        </geometry>
        <origin xyz="0.04 0 0" rpy="0 1.5708 0"/>
        <material name="silver"/>
    </visual>
    <collision>
        <geometry>
            <cylinder radius="0.02" length="0.08"/>
        </geometry>
        <origin xyz="0.04 0 0" rpy="0 1.5708 0"/>
    </collision>
</link>

<!-- Joint 6: Wrist yaw -->
<joint name="joint_6" type="revolute">
    <parent link="link_5"/>
    <child link="end_effector"/>
    <origin xyz="0.08 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="25.0" velocity="4.0"/>
</joint>

<link name="end_effector">
    <inertial>
        <origin xyz="0.03 0 0" rpy="0 0 0"/>
        <mass value="0.2"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0"
                 iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual>
        <geometry>
            <cylinder radius="0.015" length="0.06"/>
        </geometry>
        <origin xyz="0.03 0 0" rpy="0 1.5708 0"/>
        <material name="red"/>
    </visual>
    <collision>
        <geometry>
            <cylinder radius="0.02" length="0.06"/>
        </geometry>
        <origin xyz="0.03 0 0" rpy="0 1.5708 0"/>
    </collision>
</link>

</robot>
